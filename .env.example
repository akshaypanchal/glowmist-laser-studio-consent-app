# Copy to .env.local for local development. On Vercel, set these under
# Project Settings > Environment Variables. Never commit real values.

# --- Database (Turso) ---
# Local development can use a file: TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Public URL of the app, used to build signing links in emails.
APP_URL=http://localhost:3000

# --- File storage for signed PDFs and signatures ---
# "database" keeps files in Turso (no extra account needed).
# "r2" uses a private Cloudflare R2 bucket and needs the four R2_ values.
STORAGE_DRIVER=database
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Email (Resend) ---
# "console" only logs; "resend" sends real email.
EMAIL_DRIVER=console
RESEND_API_KEY=
# Must be an address on a domain verified in Resend before clients can receive mail.
EMAIL_FROM="GlowMist Laser Studio <consent@your-verified-domain.com>"
# Where the studio's copy of every signed form goes (can also be set in the dashboard).
STUDIO_RECORDS_EMAIL=glowmistlaserstudio@gmail.com

# --- Other ---
STUDIO_TIMEZONE=America/Toronto
SIGNING_LINK_TTL_HOURS=72
# Protects the daily email-retry job. Vercel sends it automatically for cron jobs.
CRON_SECRET=

# --- Only used by `npm run db:seed` ---
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=
